{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pg-dac",
  "version": "0.9.6",
  "identifier": "dev.pgdac.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pg-dac — PostgreSQL schema compare",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pg-dac"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rmnunes/pg-dac/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5M0ZGRTdFQTQ5OEI4MTIKUldRU3VKaWtmdjQvbWJhSHlsdERHSlpNcVF6eFpiY3J0Znc4VGpoYzVJNnAzeTlUSFZMYWhCV3oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
